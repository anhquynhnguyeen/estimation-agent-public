# Copy this file to ".env" and fill in the values.
# ".env" is never uploaded to GitHub. This example file has no real secrets.

# "synthetic" = fake test data only (safe anywhere)
# "real"      = real client data. Only allowed on Dokploy with AI through LiteLLM.
DATA_MODE=synthetic

# Front (read-only API token, "Shared resources" scope)
FRONT_API_TOKEN=
# Optional: only list conversations from this inbox (e.g. inb_abc123). Leave empty to list all you can see.
FRONT_INBOX_ID=

# LiteLLM (company AI gateway)
LITELLM_BASE_URL=
LITELLM_API_KEY=
LLM_MODEL=

# ClickUp and Slack (used from Day 4, test destinations only)
CLICKUP_API_TOKEN=
CLICKUP_TEST_LIST_ID=
SLACK_BOT_TOKEN=
SLACK_TEST_CHANNEL=
